# ─────────────────────────────────────────────────────────────────
# Bolsillo — variables de entorno (plantilla)
# Copia este archivo a .env y ajusta lo que necesites.
# ─────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────
# Modo A · SQLite local (desarrollo y pruebas):
# (ruta relativa a prisma/schema.prisma → carpeta db/ del proyecto)
DATABASE_URL="file:../db/custom.db"

# Modo B · Turso (producción en Vercel, plan gratis):
# Comenta la línea de arriba y descomenta estas.
# En Vercel define las TRES variables (TURSO_DATABASE_URL,
# TURSO_AUTH_TOKEN y DATABASE_URL con el mismo valor de la URL).
# TURSO_DATABASE_URL="libsql://tu-base-de-datos.turso.io"
# TURSO_AUTH_TOKEN="eyJ…token-de-turso…"
# DATABASE_URL="libsql://tu-base-de-datos.turso.io"

# ── Candado de acceso (recomendado en producción) ────────────────
# PIN para abrir la app. Si no lo defines, la app queda abierta.
# Eliminalo en local si no quieres candado.
# APP_PIN="1234"

# ── IA (opcional, producción) ────────────────────────────────────
# Cualquier API compatible con OpenAI. Recomendado: Groq (gratis,
# chat + visión OCR + voz). Crea la clave en console.groq.com/keys
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_API_KEY="gsk_…"
# AI_MODEL="llama-3.3-70b-versatile"
# AI_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"   (escáner OCR)
# AI_ASR_MODEL="whisper-large-v3"                                (voz)
# Alternativa solo texto/OCR: OpenRouter (openrouter.ai/keys)
# AI_BASE_URL="https://openrouter.ai/api/v1"
# Sin estas variables, la app funciona igual; el asistente/OCR/voz
# mostrarán un aviso claro de que la IA no está activa.
